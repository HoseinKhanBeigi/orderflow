{
  "buildCommand": "npm run build:client",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/spot/:path*", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
